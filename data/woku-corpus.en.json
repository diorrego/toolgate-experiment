{
  "version": 2,
  "purpose": "Fixed read-only question corpus; tool names are the direct baseline oracle, never an instruction to the remote selector.",
  "cases": [
    {
      "id": "Q01",
      "question": "What is the profile of the connected company?",
      "tool": "get_company",
      "arguments": {}
    },
    {
