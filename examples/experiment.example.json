{
  "version": 1,
  "model": "gpt-6-astra",
  "effort": "high",
  "corpusFile": "../.local/corpus.json",
  "privateDir": "../.local/runs",
  "provider": {
    "serverName": "benchmark_provider",
    "url": "http://127.0.0.1:8081/mcp",
    "modeFile": "../.local/provider-mode.json",
    "traceFile": "../.local/provider-traces.jsonl",
    "disableServers": []
  },
  "artifacts": {
    "go": "../backend-go/bin/toolgate",
    "rust": "../backend-rust/target/release/toolgate-core",
    "sdkRemote": "../sdk-typescript/packages/sdk/dist/remote.js",
    "sdkProvider": "../sdk-typescript/packages/sdk/dist/provider.js"
  },
  "pidFiles": {
    "go": "../.local/core-go.pid",
    "rust": "../.local/core-rust.pid",
    "provider": "../.local/provider.pid"
  },
  "environment": {
    "dataset": "Replace with the authorized dataset description, without identifiers",
    "postgres": "17.11-alpine",
    "coreAffinity": "0,1",
    "connectTimeoutMs": 1000,
    "jevTimeoutMs": 2200,
    "coreTimeoutMs": 3000,
    "sdkTimeoutMs": 3500,
    "mcpProfile": "2025-11-25"
  }
}
